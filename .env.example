# TEMPLATE ONLY — never put real credentials in this file.
# It is the one .env file that IS committed to git (see .gitignore).
# Real values belong in .env.local, which is gitignored.
#
# Sending and receiving are two separate mailboxes:
#   SMTP_USER  = the account that logs in and sends   (the "postman")
#   CONTACT_TO = where submissions land               (the inbox you read)
# They do not have to match.

# --- Contact form (nodemailer) ---
# Google Workspace / Gmail. Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# The account that authenticates and sends. Any mailbox you control.
SMTP_USER=your-sender@gmail.com

# NOT the account password. Generate a Google App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Google shows it as 4 groups of 4 characters; paste it either with or
# without the spaces — both work. Do not wrap it in quotes.
SMTP_PASS=xxxx xxxx xxxx xxxx

# Where contact form submissions are delivered.
CONTACT_TO=admin@sanctuaryforward.com

# Optional. Overrides the visible From address; defaults to SMTP_USER.
# Gmail ignores this unless it is a verified "Send mail as" alias on the
# SMTP_USER account, so most setups should leave it commented out.
# CONTACT_FROM=
